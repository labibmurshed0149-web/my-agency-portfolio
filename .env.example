# Copy this file to .env and fill values

# SMTP configuration (for production use set real values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_smtp_password_or_app_password

# Recipient for contact form notifications (defaults to SMTP_USER if blank)
CONTACT_TO=your-email@gmail.com

# Optional FROM address override
FROM=your-email@gmail.com

# Set NODE_ENV=development locally to enable console-simulated emails when SMTP is not configured
NODE_ENV=development
